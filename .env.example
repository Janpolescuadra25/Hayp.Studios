# Database Connection
# Local development (SQLite):
DATABASE_URL="file:./dev.db"
# Production deployment (PostgreSQL on Hetzner VPS vortex):
# DATABASE_URL="postgresql://user:password@localhost:5432/hayp_studios?schema=public"

# NextAuth Configuration (Server-Only — DO NOT commit real secrets)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret-key-at-least-32-chars"

# Studio Owner Initial Setup (Server-Only — DO NOT commit real credentials)
ADMIN_EMAIL="replace-with-owner-email@domain.com"
# Generate a bcrypt hash locally before deployment:
# bunx bcrypt-cli hash "your-secure-password"
ADMIN_PASSWORD_HASH="$2a$10$ReplaceWithRealBcryptHashHere"

# EmailJS Configuration (Client-Side Contact Fallback)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=replace-with-emailjs-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=replace-with-emailjs-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=replace-with-emailjs-public-key
