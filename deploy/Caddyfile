haypstudios.com, www.haypstudios.com {
    encode gzip zstd

    # Automated TLS with Let's Encrypt
    tls paulescuadra25@gmail.com

    # Request limits
    request_body {
        max_size 10MB
    }

    # Production Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Static Assets Edge Caching (Next.js immutable chunks & fonts)
    @static path /_next/static/* /static/* /favicon.ico /icon.svg
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Public images & media assets
    @images path *.png *.jpg *.jpeg *.gif *.webp *.avif *.svg *.ico *.woff *.woff2
    header @images Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

    # Deliverable 11.5: Static uploads serving with 1-day immutable edge caching
    handle /uploads/* {
        root * /var/www/hayp-studios/public
        file_server
        header Cache-Control "public, max-age=86400, immutable"
    }

    # API Routes — Disable Browser Caching
    @api path /api/*
    header @api Cache-Control "no-store, no-cache, must-revalidate"

    # HTML / Dynamic Page routes — short edge cache with revalidation
    @html not path /_next/* /api/* *.png *.jpg *.jpeg *.gif *.webp *.avif *.svg *.ico *.woff *.woff2
    header @html Cache-Control "public, max-age=0, s-maxage=60, stale-while-revalidate=300"

    reverse_proxy 127.0.0.1:3003
}