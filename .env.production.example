# ==============================================================================
# HAYP.STUDIOS — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Target Server: vortex (Hetzner VPS cx33, 2.28.120.85)
# Target Port: 3003 | Domain: https://haypstudios.com
# Security Notice: METADATA ONLY. Replace placeholders with real values on server.
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=3003
NEXT_PUBLIC_APP_URL=https://haypstudios.com

# Database Configuration (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# NextAuth Authentication Configuration
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_32_character_nextauth_secret_here
NEXTAUTH_URL=https://haypstudios.com

# Studio Admin Telemetry & Dashboard Access
# Used for protected routes at /api/analytics/metrics
ADMIN_PASSWORD=your_secure_admin_password_here

# Telemetry Sync & Cron Job Security (Optional)
# Generate a secure key using: openssl rand -hex 32
CRON_SECRET=your_hex_cron_secret_here

# ============================================================================== 
# PHASE 3: THIRD-PARTY INTEGRATIONS
# ============================================================================== 
# Instagram Basic Display API access token (long-lived)
INSTAGRAM_ACCESS_TOKEN=

# EmailJS service configuration for contact form dispatch
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
