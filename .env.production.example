# Database Connection (PostgreSQL on vortex)
DATABASE_URL="postgresql://postgres:REPLACE_WITH_PRODUCTION_DB_PASSWORD@localhost:5432/HaypStudios_db"

# NextAuth Configuration
NEXTAUTH_URL="https://haypstudios.com"
NEXTAUTH_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"

# Studio Owner & Administrator Credentials
ADMIN_EMAIL="paulescuadra25@gmail.com"
ADMIN_PASSWORD_HASH="REPLACE_WITH_BCRYPT_PASSWORD_HASH"

# Upload Storage Configuration
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_SIZE_BYTES="10485760"

# Application Environment
NODE_ENV="production"
PORT=3003
